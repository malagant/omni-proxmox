# =============================================================================
# Omni auf Proxmox — Konfiguration
# -----------------------------------------------------------------------------
#   cp config/omni.env.example config/omni.env
# Die Datei ist gitignored und enthaelt Secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Omni-Host
# -----------------------------------------------------------------------------
# Omni braucht Linux: --net=host, /dev/net/tun und WireGuard funktionieren unter
# Docker Desktop/OrbStack auf macOS nicht. Typisch ist eine kleine Debian- oder
# Ubuntu-VM auf dem Proxmox-Cluster selbst (2 vCPU, 4 GB RAM, 40 GB Disk).
#
# Muss nicht root sein. Ein normaler Benutzer braucht dann aber:
#   - Mitgliedschaft in der Gruppe docker
#   - passwortloses sudo, falls OMNI_REMOTE_DIR ausserhalb seines Home liegt
# Alternativ OMNI_REMOTE_DIR ins Home legen, dann kommt man ganz ohne sudo aus.
OMNI_SSH="root@omni.lan"

# IP, unter der sowohl dein Mac als auch die Talos-VMs den Omni-Host erreichen.
# Das ist die Adresse, die in WireGuard/SideroLink annonciert wird — kein 127.0.0.1.
OMNI_HOST_IP="10.0.10.20"

# Interne Hostnamen. Muessen nicht in echtem DNS stehen; die Skripte tragen sie
# in /etc/hosts ein (lokal und auf dem Omni-Host).
OMNI_ENDPOINT="omni.internal"
AUTH_ENDPOINT="auth.internal"

# Erster Benutzer. Wird von Omni als Admin angelegt und ist der Dex-Login.
OMNI_USER_EMAIL="admin@omni.internal"

# EULA-Bestaetigung. Ohne diese Angaben blockiert self-hosted Omni alle
# API-Aufrufe, bis du im UI zustimmst.
EULA_NAME=""
EULA_EMAIL=""

# Zielverzeichnis auf dem Omni-Host. /opt gehoert root — ohne sudo stattdessen
# etwas wie /home/<user>/omni verwenden.
OMNI_REMOTE_DIR="/opt/omni"

# -----------------------------------------------------------------------------
# Versionen
# -----------------------------------------------------------------------------
OMNI_VERSION="v1.10.3"
DEX_VERSION="v2.41.1"
PROXMOX_PROVIDER_VERSION="v0.2.0"

# -----------------------------------------------------------------------------
# Proxmox-Zugang fuer den Infra-Provider
# -----------------------------------------------------------------------------
# Achtung: der Provider will die URL MIT /api2/json.
PROXMOX_URL="https://pve1.example.lan:8006/api2/json"

# Entweder API-Token (empfohlen) ...
PROXMOX_TOKEN_ID="omni@pve!omni"
PROXMOX_TOKEN_SECRET=""

# ... oder Benutzer/Passwort. Nur setzen, wenn kein Token verwendet wird.
PROXMOX_USERNAME=""
PROXMOX_PASSWORD=""
PROXMOX_REALM="pam"

# Selbstsigniertes Proxmox-Zertifikat akzeptieren.
PROXMOX_INSECURE_SKIP_VERIFY="true"

# Name, unter dem sich der Provider bei Omni registriert.
PROXMOX_PROVIDER_ID="proxmox"

# -----------------------------------------------------------------------------
# VM-Shape (landet als providerdata in den MachineClasses)
# -----------------------------------------------------------------------------
# CEL-Ausdruck zur Auswahl des Proxmox-Storage fuer die VM-Disks.
# Ohne diesen Wert bricht der Provider im Schritt vmSync ab.
PVE_STORAGE_SELECTOR='name == "local-lvm"'

PVE_NETWORK_BRIDGE="vmbr0"
# VLAN-Tag, 0 = kein VLAN.
PVE_VLAN="0"

# Optional: Proxmox-Pool, in den die VMs einsortiert werden. Leer = kein Pool.
PVE_POOL=""

# Verteilung der VMs auf die Nodes: spread | fewer-vms | round-robin | binpack
PVE_PLACEMENT_STRATEGY="spread"

# Control-Plane-VMs
CP_CORES="4"
CP_SOCKETS="1"
CP_MEMORY="8192"      # MB
CP_DISK_SIZE="60"     # GB

# Worker-VMs
WORKER_CORES="4"
WORKER_SOCKETS="1"
WORKER_MEMORY="16384" # MB
WORKER_DISK_SIZE="100"

# -----------------------------------------------------------------------------
# Cluster
# -----------------------------------------------------------------------------
CLUSTER_NAME="omni-pve-01"
TALOS_VERSION="v1.13.8"
KUBERNETES_VERSION="v1.34.8"
CONTROL_PLANE_COUNT="3"
WORKER_COUNT="3"
